# Copy to .env (or run `make env`). Non-secret settings only: passwords and API
# tokens are files in ./secrets, created by `make secrets` (see README).
# .env is gitignored; never commit real values.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_VERSION=18.6
POSTGRES_DB=cadns
POSTGRES_USER=cadns_owner

# --- Database roles -------------------------------------------------------------
# Passwords for the least-privilege roles live in ./secrets, not here:
#   secrets/postgres_password  secrets/cadns_dlz_password  secrets/cadns_app_password

# --- Resolver ---------------------------------------------------------------------
# Host address for port 53. 127.0.0.1 keeps it local; use a LAN address (never
# 0.0.0.0 on a public host) to serve other machines.
RESOLVER_LISTEN=127.0.0.1

# --- Measurement APIs ----------------------------------------------------------------
# WattTime (https://watttime.org): MOER per grid region. The password is in
# secrets/watttime_password.
CADNS_WATTTIME_USERNAME=
# IPinfo (https://ipinfo.io): the token is in secrets/ipinfo_token. With database
# access, `make ipinfo-db` downloads the MMDB (data/ipinfo), used before the API.
