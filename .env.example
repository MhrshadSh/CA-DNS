# Copy to .env (or run `make env`, which also generates secrets).
# .env is gitignored; never commit real values.

# --- Development host ---------------------------------------------------------
# SSH target of the Ubuntu VM that runs Docker.
VM_SSH=user@vm-host
# Docker CLI context pointing at the VM (created by `make context`).
DOCKER_CONTEXT=cadns-vm

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_VERSION=18
POSTGRES_DB=cadns
POSTGRES_USER=cadns_owner
POSTGRES_PASSWORD=change-me
