# Copy to .env (or run `make env`, which also generates secrets).
# .env is gitignored; never commit real values.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_VERSION=18.6
POSTGRES_DB=cadns
POSTGRES_USER=cadns_owner
POSTGRES_PASSWORD=change-me

# --- Database roles -------------------------------------------------------------
# Login passwords for the least-privilege roles created by the migrations.
CADNS_DLZ_PASSWORD=change-me
CADNS_APP_PASSWORD=change-me

# --- Resolver ---------------------------------------------------------------------
# Host address for port 53. 127.0.0.1 keeps it local; use a LAN address (never
# 0.0.0.0 on a public host) to serve other machines.
RESOLVER_LISTEN=127.0.0.1
