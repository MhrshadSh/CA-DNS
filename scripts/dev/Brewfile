# Mac-side developer tools. Containers run in the Ubuntu VM; the Mac only
# needs the Docker CLI (no Docker Desktop).
#   make bootstrap-mac

brew "docker"          # CLI only
brew "docker-compose"  # compose plugin
brew "docker-buildx"   # buildx plugin
brew "uv"              # Python toolchain & dependency management
brew "pre-commit"      # git hooks (ruff, clang-format, shellcheck, ...)
brew "clang-format"    # C formatting for the DLZ module
brew "bind"            # dig / delv for testing the resolver
